[Unit]
Description=Hermes job agent (one-shot scrape and notify)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Use the VM login user (e.g. azureuser). For a dedicated hermes user, chown the
# app tree to hermes:hermes and run manual commands with sudo -u hermes.
User=azureuser
Group=azureuser
WorkingDirectory=/opt/hermes_agent
EnvironmentFile=/opt/hermes_agent/.env
ExecStart=/opt/hermes_agent/.venv/bin/hermes run

[Install]
WantedBy=multi-user.target
